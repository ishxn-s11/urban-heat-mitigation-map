# ── Backend ─────────────────────────────────────────────────────────────
DEMO_MODE=true
DATA_MODE=test
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
API_RATE_LIMIT=120/minute

DATABASE_URL=postgresql+psycopg://urbanflux:urbanflux@localhost:5432/urbanflux
REDIS_URL=redis://localhost:6379/0

# ── Google Earth Engine (leave blank for demo mode) ─────────────────────
GEE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Object storage ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── RAG / LLM (optional; retrieval works without it) ────────────────────
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_LLM_MODEL=gpt-4o-mini
QDRANT_URL=

# ── Frontend ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=true
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
